// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  username   String @unique
  email      String @unique
  name       String
  password   String
  occupation String
  tagline    String

  cv_url         String?
  deck_intro_url String?
  linkedin_url   String?

  photo Image?

  /// Landing page: intro paragraph for each mode, and the two faces of the
  /// hanging ID card (front = Product design, back = Photo works).
  intro_product String?
  intro_photo   String?
  card_front    Image?
  card_back     Image?
  /// The card's lanyard: optional band image and the shared look/physics
  /// settings (lib/lanyard-settings.ts has the defaults and ranges).
  band_image    Image?
  lanyard       LanyardSettings?

  workplaces     Workplace[]
  posts          Post[]
  categories     Category[]
  gallery_photos GalleryPhoto[]
}

/// One photo in the Photo works grid on /photography.
model GalleryPhoto {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  order Int
  image Image

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId
}

model Post {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  slug    String @unique
  title   String
  excerpt String

  order Int?

  header_image    Image
  thumbnail_image Image
  thumbnail_gif   Image?

  status Status @default(ACTIVE)
  /// First time the post was saved as Live (ACTIVE). Once set, the slug is
  /// locked so public links keep working.
  publishedAt DateTime?

  isRestricted         Boolean?
  passwordHashed       String?
  previewSectionAmount Int?

  post_sections PostSection[]

  categoryIds String[]   @db.ObjectId
  categories  Category[] @relation(fields: [categoryIds], references: [id])

  workplace   Workplace? @relation(fields: [workplaceId], references: [id])
  workplaceId String?    @db.ObjectId

  author   User   @relation(fields: [authorId], references: [id])
  authorId String @db.ObjectId
}

type PostSection {
  id        String
  order     Int
  title     String
  icon_type String

  contents PostSectionContent[]
}

type PostSectionContent {
  id      String
  order   Int
  content String
  image   Image?

  content_image_type   ContentImageType    @default(DEFAULT)
  content_image_radius ContentImageRadius? @default(XXL)
}

model Workplace {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  slug  String  @unique
  name  String
  url   String?
  image Image

  posts Post[]

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @db.ObjectId
}

model Category {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  slug String @unique
  name String

  postIds String[] @db.ObjectId
  posts   Post[]   @relation(fields: [postIds], references: [id])

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @db.ObjectId
}

enum ContentImageType {
  FULL
  DEFAULT
}

enum ContentImageRadius {
  SM //4
  MD //6
  LG //8
  XL //12
  XXL //16
  XXXL //24
}

enum Status {
  ACTIVE
  INACTIVE
}

type LanyardSettings {
  imageFit     String
  orientation  String
  finish       String
  metal        String
  cardColor    String
  plainBand    Boolean
  bandColor    String
  cornerRadius Float
  size         Float
  bandLength   Float
  bandWidth    Float
  anchor       String
  gravity      Float
  damping      Float
  elasticity   Float
  breeze       Float
  interactive  Boolean
  /// Old on/off for the sideways intro, kept in step with `entrance`.
  intro        Boolean
  /// "drop" | "swing" | "off". Missing on rows saved before it existed.
  entrance     String?
}

type Image {
  public_id           String
  img_url             String
  img_url_thumbnail   String
  img_url_placeholder String
  img_width           Int
  img_height          Int
  img_type            String?
}
